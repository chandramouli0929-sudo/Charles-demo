# ============================================================
# AgentForge Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ------------------------------------------------------------
# LLM Provider Configuration
# Supported: gemini | openai | anthropic | openai_compatible
# ------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=   # Only for openai_compatible (e.g., vLLM endpoint)

# Planner/Reasoning model (can use a smarter model for planning)
LLM_PLANNER_MODEL=gemini-1.5-pro

# ------------------------------------------------------------
# URL Shortener Database
# Default: SQLite (no Docker needed for quick start)
# For PostgreSQL: set DATABASE_URL to postgresql+asyncpg://...
# ------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./agentforge_urlshortener.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/urlshortener

# ------------------------------------------------------------
# Redis (optional — in-memory cache used if Redis unavailable)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ------------------------------------------------------------
# URL Shortener Settings
# ------------------------------------------------------------
BASE_URL=http://localhost:8000
SHORT_CODE_LENGTH=7

# ------------------------------------------------------------
# AgentForge System Settings
# ------------------------------------------------------------
# Path to the reference URL shortener repository (for brownfield)
REFERENCE_REPO_PATH=./reference_app/url_shortener

# Max remediation retries before giving up
MAX_REMEDIATION_RETRIES=2

# Workflow state database (LangGraph checkpointer)
WORKFLOW_DB_PATH=./agentforge_workflow.db

# ------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-a-long-random-string
